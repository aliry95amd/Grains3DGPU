<Grains3D Type="GPU" Precision="Double">

<Construction>
	<Origin X="0.0" Y="0.0" Z="0.0"/>
	<MaxCoordinate X="2.0" Y="2.0" Z="10.0"/>
	<Periodicity PX="0" PY="0" PZ="0"/>

	<CollisionDetection>
		<NeighborList Type="BruteForce" UpdateFrequency="1"/>
		<LinkedCell Type="DeviceMemoryEfficient" CellSizeFactor="1." SortingFrequency="100"/>
		<BoundingVolume Type="OBB"/>
		<NarrowPhase Type="GJK"/>
	</CollisionDetection>

	<ContactForceModels>
		<ContactForceModel Type='Hooke'>
			<Material materialA="matP" materialB="matP"/>
			<Parameters>
				<kn>120000000.0</kn>
				<en>0.1</en>
				<etat>100.0</etat>
				<muc>0.5</muc>
				<kr>0.0</kr>
			</Parameters>
		</ContactForceModel>
	</ContactForceModels>

	<TemporalSetting>
		<TimeInterval Start="0." End="1e-05" dt="1e-05"/>
		<TimeIntegration Type="FirstOrderExplicit"/>
	</TemporalSetting>

	<Particles>
		<Particle Number="200" Density="1000.0" Material="matP">
			<Convex CrustThickness="0.01">
				<Sphere Radius="0.04"/>
			</Convex>
		</Particle>
	</Particles>

	<Obstacles>
		<!-- Bottom wall (1.0 x 1.0) -->
		<Obstacle Material="matP">
			<Convex CrustThickness="1.e-5">
				<Rectangle LX="1.0" LY="1.0" LZ="0.0"/>
			</Convex>
			<Transformation>
				<Centre X="0.5" Y="0.5" Z="0.0"/>
				<AngularPosition Type="Angle" aX="0." aY="0." aZ="0"/>
			</Transformation>
		</Obstacle>
		
		<!-- Right wall (X=1.0): 1.0 x 5.0 -->
		<Obstacle Material="matP">
			<Convex CrustThickness="1.e-5">
				<Rectangle LX="1.0" LY="5.0" LZ="0.001"/>
			</Convex>
			<Transformation>
				<Centre X="1.0" Y="0.5" Z="2.5"/>
				<AngularPosition Type="Angle" aX="0." aY="-90." aZ="0."/>
			</Transformation>
		</Obstacle>
		
		<!-- Left wall (X=0): 1.0 x 5.0 -->
		<Obstacle Material="matP">
			<Convex CrustThickness="1.e-5">
				<Rectangle LX="1.0" LY="5.0" LZ="0.001"/>
			</Convex>
			<Transformation>
				<Centre X="0.0" Y="0.5" Z="2.5"/>
				<AngularPosition Type="Angle" aX="0." aY="90." aZ="0."/>
			</Transformation>
		</Obstacle>
		
		<!-- Back wall (Y=1.0): 1.0 x 5.0 -->
		<Obstacle Material="matP">
			<Convex CrustThickness="1.e-5">
				<Rectangle LX="1.0" LY="5.0" LZ="0.001"/>
			</Convex>
			<Transformation>
				<Centre X="0.5" Y="1.0" Z="2.5"/>
				<AngularPosition Type="Angle" aX="90." aY="0." aZ="0."/>
			</Transformation>
		</Obstacle>
		
		<!-- Front wall (Y=0): 1.0 x 5.0 -->
		<Obstacle Material="matP">
			<Convex CrustThickness="1.e-5">
				<Rectangle LX="1.0" LY="5.0" LZ="0.001"/>
			</Convex>
			<Transformation>
				<Centre X="0.5" Y="0.0" Z="2.5"/>
				<AngularPosition Type="Angle" aX="-90." aY="0." aZ="0."/>
			</Transformation>
		</Obstacle>
	</Obstacles>
</Construction>

<Forces>
	<Gravity GX="0.0" GY="0.0" GZ="-9.81"/>
</Forces>

<Simulation>
	<ParticleInsertion ForceInsertion="0">
		<InitialPosition Type="Random" Seed="UserDefined" Value="1">
			<Windows>
				<Window Type="Box">
					<MinPoint X="0.0" Y="0.0" Z="0.0"/>
					<MaxPoint X="1.0" Y="1.0" Z="10.0"/>
				</Window>
			</Windows>
		</InitialPosition>
	</ParticleInsertion>
	<PostProcessing>
		<TimeSave dt="1e-05"/>
		<Writers>
			<Paraview Directory="./Grains/Init" RootName="insert"/>
			<RawData  Directory="./Grains/Init" RootName="insert"/>
		</Writers>
	</PostProcessing>
</Simulation>

</Grains3D>