<Grains3D Type="{sim_type}" Precision="{precision}">

<Construction>
	<Origin X="0.0" Y="0.0" Z="0.0"/>
	<MaxCoordinate X="{domain_size}" Y="{domain_size}" Z="{domain_size}"/>
	<Periodicity PX="0" PY="0" PZ="0"/>

	<CollisionDetection>
		<NeighborList Type="{neighbor_list_type}"/>
		{linked_cell_config}
		<BoundingVolume Type="OBB"/>
		<NarrowPhase Type="GJK"/>
	</CollisionDetection>

	<ContactForceModels>
		<ContactForceModel Type='Hooke'>
			<Material materialA="mat1" materialB="mat1"/>
			<Parameters kn="{kn}" en="{en}" etat="{etat}" muc="{muc}" kr="{kr}"/>
		</ContactForceModel>
	</ContactForceModels>

	<TemporalSetting>
		<TimeInterval Start="0.0" End="{t_end}" dt="{dt}"/>
		<TimeIntegration Type="FirstOrderExplicit"/>
	</TemporalSetting>

	<Particles>
{particles_section}
	</Particles>

	<Obstacles>
		<Obstacle Material="mat1">
			<Convex CrustThickness="1.e-5">
				<Rectangle LX="{domain_size}" LY="{domain_size}" LZ="0.0"/>
			</Convex>
			<Transformation>
				<Centre X="{domain_center}" Y="{domain_center}" Z="0.0"/>
				<AngularPosition Type="Angle" aX="0." aY="0." aZ="0"/>
			</Transformation>
		</Obstacle>
		<Obstacle Material="mat1">
			<Convex CrustThickness="1.e-5">
				<Rectangle LX="{domain_size}" LY="{domain_size}" LZ="0.001"/>
			</Convex>
			<Transformation>
				<Centre X="{domain_size}" Y="{domain_center}" Z="{domain_center}"/>
				<AngularPosition Type="Angle" aX="0." aY="-90." aZ="0."/>
			</Transformation>
		</Obstacle>
		<Obstacle Material="mat1">
			<Convex CrustThickness="1.e-5">
				<Rectangle LX="{domain_size}" LY="{domain_size}" LZ="0.001"/>
			</Convex>
			<Transformation>
				<Centre X="0.0" Y="{domain_center}" Z="{domain_center}"/>
				<AngularPosition Type="Angle" aX="0." aY="90." aZ="0."/>
			</Transformation>
		</Obstacle>
		<Obstacle Material="mat1">
			<Convex CrustThickness="1.e-5">
				<Rectangle LX="{domain_size}" LY="{domain_size}" LZ="0.001"/>
			</Convex>
			<Transformation>
				<Centre X="{domain_center}" Y="{domain_size}" Z="{domain_center}"/>
				<AngularPosition Type="Angle" aX="90." aY="0." aZ="0."/>
			</Transformation>
		</Obstacle>
		<Obstacle Material="mat1">
			<Convex CrustThickness="1.e-5">
				<Rectangle LX="{domain_size}" LY="{domain_size}" LZ="0.001"/>
			</Convex>
			<Transformation>
				<Centre X="{domain_center}" Y="0.0" Z="{domain_center}"/>
				<AngularPosition Type="Angle" aX="-90." aY="0." aZ="0."/>
			</Transformation>
		</Obstacle>
	</Obstacles>
</Construction>

<Forces>
	<Gravity GX="0.0" GY="0.0" GZ="-9.81"/>
</Forces>

<Simulation>
	<ParticleInsertion ForceInsertion="0">
		<InitialPosition Type="Random" Seed="UserDefined" Value="1">
			<Windows>
				<Window Type="Box">
					<MinPoint X="0.0" Y="0.0" Z="0.0"/>
					<MaxPoint X="{domain_size}" Y="{domain_size}" Z="{domain_size}"/>
				</Window>
			</Windows>
		</InitialPosition>
		<InitialOrientation Type="Random" Seed="UserDefined" Value="1">
			<Windows>
				<Window Type="Box">
					<MinPoint X="0" Y="0" Z="0"/>
					<MaxPoint X="6.28" Y="6.28" Z="6.28"/>
				</Window>
			</Windows>
		</InitialOrientation>
	</ParticleInsertion>
</Simulation>

</Grains3D>
